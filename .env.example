# Database. Any Postgres URL (Neon, Supabase, Vercel Postgres). Leave empty to run a local in-process Postgres under data/pglite.
DATABASE_URL=

# Leave these empty to run in test mode (texts go to /dev/texts, payments are simulated).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# stripe: sk_test_… uses Stripe's test card (pm_card_visa) for givers; sk_live_… needs a pm_… id from the client.
# Owners onboard via Stripe Express Connect from /wallet/payout; cash-outs are Transfers (5% kept by the platform).
STRIPE_SECRET_KEY=
# Public base URL used in text links
APP_URL=http://localhost:3000

# a4: secret for the scheduled-work endpoint /api/cron?key=… (reminders, scheduled surprises, weekly digest)
CRON_KEY=
# Vercel cron (vercel.json, every 15 minutes) sends Authorization: Bearer $CRON_SECRET. Set it in Vercel project env.
CRON_SECRET=

# Sign-in codes via Twilio Verify (no A2P registration needed): the Verify Service SID, starts with VA
TWILIO_VERIFY_SID=
# Set to 1 only after A2P 10DLC registration is approved; until then automatic texts are held
TWILIO_SMS_ENABLED=
