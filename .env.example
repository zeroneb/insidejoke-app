# Database. Any Postgres URL (Neon, Supabase, Vercel Postgres). Leave empty to run a local in-process Postgres under data/pglite.
DATABASE_URL=

# Leave these empty to run in test mode (texts go to /dev/texts, payments are simulated).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
STRIPE_SECRET_KEY=
# Public base URL used in text links
APP_URL=http://localhost:3000
